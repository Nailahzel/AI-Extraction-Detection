{
  "scope": "Standard access without bulk passes. Synthetic development scenarios with virtual arrival times. Detection means throttle/block, not a speed bump. No actual waiting, LLM generation, independent holdout, or cloning-success measurement.",
  "policy": {
    "version": "chat-heuristics-v2",
    "window_seconds": 60,
    "monitor_threshold": 35,
    "throttle_threshold": 60,
    "block_threshold": 80,
    "throttle_seconds": 5,
    "block_seconds": 30,
    "speed_bumps": [
      {
        "threshold": 40,
        "seconds": 1
      },
      {
        "threshold": 50,
        "seconds": 3
      }
    ],
    "bulk_pass": {
      "max_requests": 30,
      "max_minutes": 60,
      "max_concurrency": 2,
      "repetition_override": 0.65,
      "scope": "Approved arrivals receive rate credit. At least 8 recent inputs and repetition >= 0.65 remove that credit. Diversity and repetition still count."
    },
    "weights": {
      "rate": 45,
      "diversity": 20,
      "repetition": 35
    },
    "scope": "Request-side heuristics; not validated by the classifier benchmarks."
  },
  "sessions": 60,
  "attack_sessions": 36,
  "detected_attacks": 24,
  "benign_sessions": 24,
  "false_positives": 12,
  "detection_rate": 0.6666666666666666,
  "false_positive_rate": 0.5,
  "profiles": {
    "normal_conversation": {
      "sessions": 12,
      "flagged": 0
    },
    "legitimate_bulk_questions": {
      "sessions": 12,
      "flagged": 12
    },
    "repeated_extraction_probes": {
      "sessions": 12,
      "flagged": 12
    },
    "diverse_extraction_queries": {
      "sessions": 12,
      "flagged": 12
    },
    "slow_extraction_probes": {
      "sessions": 12,
      "flagged": 0
    }
  },
  "limitations": [
    "A legitimate bulk request and an extraction burst can have identical observable inputs and timing; this detector cannot infer their intent.",
    "Slow extraction can evade the request-rate component.",
    "The policy was designed on similar patterns; these are reproducibility checks, not independent accuracy estimates.",
    "Earlier classifier measurements do not establish protection for the chat language model.",
    "This baseline does not simulate server-side pacing or trusted bulk approvals. See protection-check.json for separate real-model integration scenarios; those are not an accuracy benchmark."
  ],
